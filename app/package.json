    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.57.14",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.0.0"
  }
}
