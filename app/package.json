{
  "name": "cmdk-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare:prototype": "node scripts/copy-prototype.mjs",
    "dev": "pnpm run prepare:prototype && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
