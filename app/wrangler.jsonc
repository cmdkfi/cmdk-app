{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static build (Vite → ./dist) served from the asset store, no Worker script. Deployed to the founder's Cloudflare
  // account at https://testnet.cmdk.fi by .github/workflows/deploy-testnet.yml on every push to main (decided 5 Nov);
  // https://cmdk.fi stays the landing. The relayer's CORS allows this origin.
  "name": "cmdk-app-testnet",
  "compatibility_date": "2026-11-01",
  // Branch previews: .github/workflows/preview.yml uploads a version, which needs a preview URL on the worker.
  "preview_urls": true,
  "routes": [{ "pattern": "testnet.cmdk.fi", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
